# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.pdf binary
*.zip binary

# Documentation
*.md text diff=markdown
LICENSE text eol=lf

# Config files
.prettierrc text eol=lf
.eslintrc text eol=lf
tsconfig.json text eol=lf
