<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescreve arquivos e pastas reais
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType text/plain .txt
  AddType image/svg+xml .svg
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  # Cache forte para assets versionados
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf|wasm|png|jpg|jpeg|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML sem cache agressivo
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Manifest, robots e sitemaps com cache curto
  <FilesMatch "^(manifest\.webmanifest|robots\.txt|sitemap.*\.xml|llms.*\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

Options -Indexes
DirectoryIndex index.html