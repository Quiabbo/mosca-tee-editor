  <name>Mosca Tee</name>
  <name xml:lang="pt_BR">Mosca Tee</name>
  <summary>Professional graphics editor with accessibility</summary>
  <summary xml:lang="pt_BR">Editor gráfico profissional com acessibilidade</summary>

  <developer id="com.moscatee">
    <name>Filipi Hadji</name>
